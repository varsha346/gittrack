type Query {

    me: User

    user(id: ID!): User

    userByUsername(username: String!): User
}

extend type Mutation {

    updateProfile(input: UpdateProfileInput!): User
}

type User {

    id: ID!

    username: String!

    email: String!

    bio: String

    avatarUrl: String
}

input UpdateProfileInput {

    bio: String

    avatarUrl: String
}